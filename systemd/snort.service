[Unit]
Description=Snort IDS
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=/usr/sbin/snort -T -k none -c /etc/snort/snort.conf -i eth0
ExecStart=/usr/sbin/snort -q \
    -k none \
    -c /etc/snort/snort.conf \
    -i eth0 \
    -l /var/log/snort \
    -A fast \
    -K ascii
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
